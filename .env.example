# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=votacion_user
POSTGRES_PASSWORD=votacion_pass_change_me
POSTGRES_DB=votacion_db

# ─── Prisma / Backend ──────────────────────────────────────────
# Usada por Prisma dentro del contenedor backend
DATABASE_URL="postgresql://votacion_user:votacion_pass_change_me@db:5432/votacion_db?schema=public"

# URL de la base de datos para Prisma desde el host (migraciones locales sin Docker)
DATABASE_URL_LOCAL="postgresql://votacion_user:votacion_pass_change_me@localhost:5432/votacion_db?schema=public"

# ─── Backend ───────────────────────────────────────────────────
BACKEND_PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
